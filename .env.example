NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="GenZee Psychologist <hello@yourdomain.com>"
EMAIL_REPLY_TO="hello@yourdomain.com"
ADMIN_NOTIFICATION_EMAIL="psychologist@yourdomain.com"

# Cron Job Authentication
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Admin Setup (used only for seeding the first admin)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-before-production"
